    "title": "3-n8n Webhook(ip-block)",
    "description": "반복 로그인 실패 출발지 IP 실차단 트리",
    "config": {
      "type": "http-notification-v2",
      "basic_auth": "[개인 PC에서 다시 입력할 인증 정보]",
      "api_key_as_header": "[REDACTED]",
      "api_key": "[REDACTED]",
      "api_secret": "[REDACTED]",
      "url": "[개인 PC의 Webhook URL]",
      "skip_tls_verification": true,
      "method": "POST",
      "time_zone": "UTC",
      "content_type": "JSON",
      "headers": "[개인 PC에서 다시 입력할 헤더]",
      "body_template": "{\"src_ip\":\"${event.fields.src_ip}\",\"count\":5,\"student\":\"lsy\",\"rule\":\"${event_definition_title}\"}"
    }
  },
