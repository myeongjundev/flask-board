      "api_key": "[REDACTED]",
      "api_secret": "[REDACTED]",
      "url": "[개인 PC의 Webhook URL]",
      "skip_tls_verification": true,
      "method": "POST",
      "time_zone": "Asia/Seoul",
      "content_type": "JSON",
      "headers": "[개인 PC에서 다시 입력할 헤더]",
      "body_template": "{\"source\":\"wazuh\",\"rule_id\":\"${event.fields.rule_id}\",\"rule_level\":\"${event.fields.rule_level}\",\"description\":\"${event.fields.description}\",\"srcip\":\"${event.fields.srcip}\",\"user\":\"${event.fields.user}\",\"file\":\"${event.fields.file}\",\"fim_event\":\"${event.fields.fim_event}\",\"agent\":\"${event.fields.agent}\",\"title\":\"${event_definition_title}\",\"student\":\"lsy\"}"
    }
  },
